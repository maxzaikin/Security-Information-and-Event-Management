#!/usr/bin/env bash
# Block commits that contain Claude Code files, local-only _private/ data
# or notebooks with outputs.
# Enable once per clone:  git config core.hooksPath .githooks
fail=0

# 1. Claude Code files (even if force-added with `git add -f`)
claude_files=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '(^|/)(\.claude/|CLAUDE(\.local)?\.md$|\.mcp\.json$)')
if [ -n "$claude_files" ]; then
    echo "pre-commit: Claude Code files must not be committed:" >&2
    echo "$claude_files" | sed 's/^/  /' >&2
    fail=1
fi

# 2. Local-only analysis data in _private/ (even if force-added with `git add -f`)
private_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)_private/|_real_data\.ipynb$')
if [ -n "$private_files" ]; then
    echo "pre-commit: local-only files (_private/, *_real_data.ipynb) must never be committed:" >&2
    echo "$private_files" | sed 's/^/  /' >&2
    echo "  unstage with: git restore --staged <file>" >&2
    fail=1
fi

# 3. Jupyter notebooks with outputs (outputs may contain real SIEM data)
for nb in $(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ipynb$'); do
    if git show ":$nb" | python3 -c '
import json, sys
nb = json.load(sys.stdin)
sys.exit(1 if any(c.get("outputs") for c in nb.get("cells", []) if c.get("cell_type") == "code") else 0)
'; then :; else
        echo "pre-commit: $nb has outputs; clear them first:" >&2
        echo "  jupyter nbconvert --clear-output --inplace \"$nb\"" >&2
        fail=1
    fi
done

exit $fail
